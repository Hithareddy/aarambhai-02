# Application
APP_NAME=Aarambh AI Backend
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (async psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aarambh
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
# List of allowed origins. CORS_ORIGIN_REGEX additionally allows any
# localhost/127.0.0.1 port so the Vite dev server works on 8080, 8082, etc.
CORS_ORIGINS=["http://localhost:3000","http://localhost:4173","http://localhost:5173","http://localhost:8080","http://localhost:8081","http://localhost:8082","http://localhost:8083"]
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI Integration (Future)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (Future)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# File Storage (Future)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
